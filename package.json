{
  "name": "nexus-live",
  "version": "5.1.0",
  "description": "Nexus Freelancer OS — Live Notion backend, multi-workspace support, job feed + role simulator",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node seed.js",
    "setup:scenarios": "node setup-scenarios.js",
    "test": "jest --coverage"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.1",
    "cheerio": "^1.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "d3": "^7.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-session": "^1.18.1",
    "google-trends-api": "^4.9.2",
    "mammoth": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "officeparser": "^6.0.4",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-linkedin-oauth2": "^2.0.0",
    "passport-local": "^1.0.0",
    "pdf-parse": "^1.1.1",
    "rss-parser": "^3.13.0",
    "session-file-store": "^1.5.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "jest": "^30.2.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "lib/**/*.js",
      "routes/**/*.js"
    ]
  }
}
