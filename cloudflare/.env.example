# Nexus — Supabase foundation environment template.
# Copy to .env (git-ignored) and fill in. Nothing here is committed.

# ── Frontend (Vite, apps/web) ────────────────────────────────────────────────
# Safe to expose to the browser. Anon key is RLS-protected.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Edge Function secrets (set via `supabase secrets set KEY=value`) ──────────
# Injected by Supabase, do not set manually in production:
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY are provided to functions at runtime.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
WEB_ORIGIN=http://localhost:5173

# LLM (agents). Set at least one; each agent_configs row picks provider + model.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Integrations — financial data linking (fill the ones you use)
MONEYBIRD_API_TOKEN=
# per-user administration id goes in data_sources.config_json, not here
WISE_API_KEY=
# per-user profile id goes in data_sources.config_json
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
# per-user account id goes in data_sources.config_json

# ── Vault secrets for pg_cron (set once via SQL, see SETUP.md) ────────────────
# edge_base_url   = https://YOUR-PROJECT-REF.supabase.co/functions/v1
# edge_service_key = your-service-role-key
