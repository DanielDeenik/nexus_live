# .env.deploy.example — copy to .env.deploy and fill in.
# Used by scripts/deploy.sh to render wrangler.template.toml. Gitignored.
# ZERO HARDCODED VALUES — every Cloudflare ID lives here, not in wrangler.toml.

# --- Cloudflare account / worker ---
CLOUDFLARE_ACCOUNT_ID=
WORKER_NAME=nexus-live-api
COMPATIBILITY_DATE=2025-01-15

# --- Routes / domain ---
ZONE_NAME=
API_DEV_ROUTE=
API_PROD_ROUTE=
API_BASE_URL=
WEB_BASE_URL=

# --- D1 ---
D1_DATABASE_NAME=nexus-live-db
D1_DATABASE_ID=
D1_PREVIEW_DATABASE_ID=

# --- KV cache ---
KV_CACHE_ID=
KV_CACHE_PREVIEW_ID=

# --- R2 ---
R2_BUCKET_NAME=nexus-live-files
R2_BUCKET_PREVIEW_NAME=nexus-live-files-preview

# --- LLM ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-1

# --- Auth ---
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# --- Cron schedules ---
CRON_DAILY=0 6 * * *
CRON_FEED_REFRESH=0 */4 * * *

# --- Pages (web) project ---
PAGES_PROJECT_NAME=nexus-live-web
