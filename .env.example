# ─── Notion Integration ─────────────────────────────────────────
NOTION_TOKEN=your_notion_integration_token

# ─── Notion Database IDs ─────────────────────────────────────────
DB_PROFILE=
DB_EXPENSES=
DB_CONTRACTS=
DB_SIGNALS=
DB_CASHFLOW=
DB_COMPANIES=
DB_OPPORTUNITIES=
DB_HISTORY=
DB_REGULATORY=

# ─── Nexus Budget App ────────────────────────────────────────────
BUDGET_APP_URL=http://localhost:8501

# ─── LinkedIn OAuth ──────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
