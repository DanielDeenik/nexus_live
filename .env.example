# ─── Google OAuth ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Session ─────────────────────────────────────────────────────
SESSION_SECRET=change-this-to-a-random-32-char-string

# ─── Server ──────────────────────────────────────────────────────
PORT=3333
