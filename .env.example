# ── Nexus Live — Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── Notion Integration ────────────────────────────────────────────────────────
NOTION_TOKEN=ntn_your_integration_token_here

# ── Notion Database IDs ───────────────────────────────────────────────────────
DB_PROFILE=
DB_EXPENSES=
DB_CONTRACTS=
DB_SIGNALS=
DB_CASHFLOW=
DB_COMPANIES=
DB_OPPORTUNITIES=
DB_HISTORY=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3333
NODE_ENV=development

# ── Sandbox Access (optional) ─────────────────────────────────────────────────
# Set both to enable HTTP Basic Auth on the hosted instance.
# Leave blank for local dev (no auth).
SANDBOX_USER=
SANDBOX_PASS=

# ── LinkedIn OAuth (optional — enables "Connect with LinkedIn" in onboarding) ─
# 1. Go to https://www.linkedin.com/developers/ → Create App
# 2. Under "Auth" tab → add Redirect URL: http://localhost:3333/api/onboard/linkedin/callback
# 3. Request "Sign In with LinkedIn using OpenID Connect" product
# 4. Copy Client ID and Client Secret below
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3333/api/onboard/linkedin/callback

# ── Budget App Integration (optional) ────────────────────────────────────────
# Leave blank in hosted mode.
BUDGET_APP_URL=http://localhost:8501
